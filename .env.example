# Backend Configuration
BACKEND_PORT=8000
BACKEND_DB_PATH=/app/data/conduit.db
BACKEND_LOG_LEVEL=info

# Frontend Configuration
FRONTEND_PORT=8282
FRONTEND_PORT_INTERNAL=4173
# For local development: http://localhost:8000/api
# For cloud deployment: https://your-api-domain.com/api
FRONTEND_API_URL=http://localhost:8000/api

# Security Configuration
CORS_ALLOW_ORIGINS=*
ALLOWED_HOSTS=*
DEBUG=False

# Optional: Django Secret Key (should be set in production)
# SECRET_KEY=your-secret-key-here
